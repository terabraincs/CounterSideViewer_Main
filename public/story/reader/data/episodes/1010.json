attle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":1455,"y":585,"connectors":[{"name":"LINE_DOWN","left":966.68,"top":550,"width":340,"height":50,"angle":-30,"originX":1,"originY":0.5}]}},{"id":31101064,"strId":"STAGE_SIDESTORY_31101064","act":6,"index":4,"uiNumber":14,"title":"인터루드 #13","description":"학회는 빠르게, 그리고 은밀하게 세력을 구축해 왔다. 기관은 그들을 막기 위해 필사적으로 투쟁해 왔지만 언제나 전략적인 목표를 달성한 것은 아니었고, 몇 차례의 치명적인 패배도 맛봐야 했다.","characterId":"NKM_UNIT_S_ESPR_PILE","characterSpine":{"id":"illustration/ab_unit_illust_nkm_unit_s_espr_pile/UNIT_ILLUST_S_ESPR_PILE/UNIT_ILLUST_S_ESPR_PILE","jsonUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_s_espr_pile/UNIT_ILLUST_S_ESPR_PILE/UNIT_ILLUST_S_ESPR_PILE.json","atlasUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_s_espr_pile/UNIT_ILLUST_S_ESPR_PILE/UNIT_ILLUST_S_ESPR_PILE.atlas","textureUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_s_espr_pile/UNIT_ILLUST_S_ESPR_PILE/UNIT_ILLUST_S_ESPR_PILE.png","defaultMix":0.2,"skeletonScale":0.01,"layout":{"x":-120,"y":311,"scaleX":0.62642092,"scaleY":0.62642092,"rotation":0,"flipX":false,"flipY":false}},"characterSkinName":"default","nodeKind":"story","cutscenes":[{"id":"HORIZON_ACT6_INTERLUDE2","title":"현재, 허가 받지 않은 침입자가 실험체 보관구역에 침입했습니다.","commandCount":51,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/HORIZON_ACT6_INTERLUDE2.json","position":"before","label":"전편"}],"layout":{"slot":3,"kind":"story","width":150,"height":110,"visualWidth":268,"visualHeight":228,"x":1945,"y":585,"connectors":[{"name":"LINE_CENTER","left":1600.8,"top":560,"width":300,"height":50,"angle":0,"originX":1,"originY":0.5}]}},{"id":31101065,"strId":"STAGE_SIDESTORY_31101065","act":6,"index":5,"uiNumber":3,"title":"결투","description":"박수와 환호로 맞이해 주세요. 그녀의 이름은 호라이즌.