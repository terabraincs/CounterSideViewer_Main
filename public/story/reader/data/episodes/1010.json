ithub.io/main/public/story/reader/scenes/HORIZON_ACT2_STAGE4_START.json","position":"before","label":"전편"}],"layout":{"slot":6,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":3415,"y":585,"connectors":[{"name":"LINE_CENTER","left":2970.8,"top":560,"width":300,"height":50,"angle":0,"originX":1,"originY":0.5}]}},{"id":31101028,"strId":"STAGE_SIDESTORY_31101028","act":2,"index":8,"uiNumber":8,"title":"인터루드 #7","description":"샤레이드는 날마다 생존 경쟁이 펼쳐지는 잔인한 밀림과 같다. 앞에서는 누구보다 세련된 모습을 선보이지만, 그 이면은 총칼 대신 금품으로 벌이는 전쟁이다.","characterId":"NKM_UNIT_HARMONY_C_VIOLIN","characterSpine":{"id":"illustration/ab_unit_illust_nkm_unit_harmony_c_violin/UNIT_ILLUST_HARMONY_C_VIOLIN/UNIT_ILLUST_HARMONY_C_VIOLIN","jsonUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_harmony_c_violin/UNIT_ILLUST_HARMONY_C_VIOLIN/UNIT_ILLUST_HARMONY_C_VIOLIN.json","atlasUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_harmony_c_violin/UNIT_ILLUST_HARMONY_C_VIOLIN/UNIT_ILLUST_HARMONY_C_VIOLIN.atlas","textureUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/spine/illustration/ab_unit_illust_nkm_unit_harmony_c_violin/UNIT_ILLUST_HARMONY_C_VIOLIN/UNIT_ILLUST_HARMONY_C_VIOLIN.png","defaultMix":0.2,"skeletonScale":0.01,"layout":{"x":-144,"y":327,"scaleX":0.414069,"scaleY":0.414069,"rotation":0,"flipX":false,"flipY":false}},"characterSkinName":"default","nodeKind":"story","cutscenes":[{"id":"HORIZON_ACT2_INTERLUDE4","title":"주문하신 주류를 가져왔습니다, 손님.","commandCount":57,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/HORIZON_ACT2_INTERLUDE4.json","position":"before","label":"전편"}],"layout":{"slot":7,"kind":"story","width":150,"height":110,"visualWidth":268,"visualHeight":228,"x":3905,"y":585,"connectors":[{"name":"LINE_CENTER","left":3560.8,"top":560,"width":300,"height":50,"angle":0,"originX":