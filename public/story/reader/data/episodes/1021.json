acterSkinName":"default","nodeKind":"story","cutscenes":[{"id":"NANAHARA2_ACT1_INTERLUDE5","title":"급한 고비는 넘기셨대. 지금 막 안정을 되찾으셨어.","commandCount":151,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/NANAHARA2_ACT1_INTERLUDE5.json","position":"before","label":"전편"}],"layout":{"slot":7,"kind":"story","width":150,"height":110,"visualWidth":268,"visualHeight":228,"x":3505,"y":733,"connectors":[{"name":"LINE_CENTER","left":3160.8,"top":708,"width":300,"height":50,"angle":0,"originX":1,"originY":0.5}]}},{"id":31102119,"strId":"STAGE_SIDESTORY_31102119","act":1,"index":9,"uiNumber":3,"title":"듣지 못하는 무녀","description":"명부신이시여. 오로치가 다시 깨어나면 어떻게 해야 합니까? \n첫번째 자손이 물었다. \n내 영혼으로 구슬을 벼려 너희의 영지에 결계를 세워라. 육체 없는 역신의 혼은 그 벽을 넘지 못할 것이다.","characterId":"","characterSpine":null,"nodeKind":"battle","cutscenes":[{"id":"NANAHARA2_ACT1_STAGE3_START","title":"역신 오로치를 막기 위해 많은 희생이 있었다.","commandCount":97,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/NANAHARA2_ACT1_STAGE3_START.json","position":"before","label":"전편"},{"id":"NANAHARA2_ACT1_STAGE3_END","title":"이쪽은 어느 정도 정리된 것 같군요.","commandCount":26,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/NANAHARA2_ACT1_STAGE3_END.json","position":"after","label":"후편"}],"layout":{"slot":8,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":3995,"y":585,"connectors":[{"name":"LINE_DOWN","left":3506.68,"top":550,"width":340,"height":50,"angle":-30,"originX":1,"originY":0.5}]}},{"id":311021110,"strId":"STAGE_SIDESTORY_311021110","act":1,"index":10,"uiNumber":4,"title":"만들어진 무녀","description":"명부신이시여. 오로치의 영혼이 마땅한 그릇을 찾아 결계를 넘어왔을 땐 어떻게 해야 합니까?\n두번째 자손이 물었다.\n역신의 비늘로 검을 벼려라. 그 검으로 바친 나나하라의 피가 역신의 분노를 잠재워줄 것이다.","characterId":"","characterSpine":null,"nodeKind":"battle","cutscenes":[{"id":"NANAHARA2_ACT1_STAGE4_START","title":"젠장, 하필 이런 때에 침식사태라니. 지원을 기대할