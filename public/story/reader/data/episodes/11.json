ncs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE1_START.json","position":"before","label":"전편"},{"id":"EP9_5_ACT3_STAGE1_END","title":"오르카 씨!! 괜찮아요? 눈 좀 떠 봐요!","commandCount":37,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE1_END.json","position":"after","label":"후편"}],"layout":{"slot":1,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":865,"y":438,"connectors":[{"name":"LINE_DOWN","left":256.68,"top":403,"width":460,"height":50,"angle":-49,"originX":1,"originY":0.5}]}},{"id":111133,"strId":"STAGE_MAINSTREAM_111133","act":3,"index":3,"uiNumber":2,"title":"여로(상)","description":"용병이 엄마가 준 목걸이를 들고 사라졌을 때는 이미 늦은 뒤였어요. 사랑도 재산도 모두 탕진해 버린 미용사는 마지막 남은 하나도 버리기로 했죠.\n그 날, 절망의 냄새를 맡은 짐승이 말을 걸었습니다.\n「왜 그렇게 울상이니? 어차피 죽을 거면 나 좀 도와 줘!」","characterId":"","characterSpine":null,"nodeKind":"battle","cutscenes":[{"id":"EP9_5_ACT3_STAGE2_START","title":"정말 이런 곳에 통로가 숨겨져 있었군요.","commandCount":28,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE2_START.json","position":"before","label":"전편"},{"id":"EP9_5_ACT3_STAGE2_END","title":"도착할 때까지 트렁크에 처박혀 있으라니, 취급이 왜 이래?","commandCount":48,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE2_END.json","position":"after","label":"후편"}],"layout":{"slot":2,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":1455,"y":438,"connectors":[{"name":"LINE_CENTER","left":1010.8,"top":413,"width":300,"height":50,"angle":0,"originX":1,"originY":0.5}]}},{"id":111134,"strId":"STAGE_MAINSTREAM_111134","act":3,"index":4,"uiNumber":3,"title":"여로(하)","description":"용병에게서 목걸이를 되찾았지만 미용사는 기분이 나아지지 않았어요. 이제 모두가 미용사를 미워했거든요.\n짐승이 물었습니다. 「사람을 죽인 게 나쁠까, 사람을 죽이게 만드는 게 나쁠까?」 미용사는 답을 알고 싶지 않았어요.","characterId":"","characterSpine":null,"nodeKind":"battle","cutscenes":[{"id":"EP9_5_ACT3_STAGE3_END","title":"……목숨은 장담할 수 없겠지만.","commandCount":51,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE3_END.json","position":"after","label":"후편"}],"layout":{"slot":3,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":1455,"y":648,"connectors":[{"name":"LINE_CENTER","left":1311.3,"top":524,"width":287.4,"height":50,"angle":-90,"originX":0.5,"originY":0.5}]}},{"id":111135,"strId":"STAGE_MAINSTREAM_111135","act":3,"index":5,"uiNumber":4,"title":"대리인","description":"「죽고 싶어.」 짐승은 미용사의 변덕을 이해했습니다. 그들은 마음 깊은 곳까지 이어져 있었으니까요. 「이제는 예전으로 돌아갈 수 없는걸」 사실 목걸이는 이제 중요하지 않았습니다. 어머니의 손자국은 핏물에 지워져 버렸거든요.\n「내가 있잖아.」 미용사는 짐승의 위로를 듣지 않고, 편한 길을 택했습니다.","characterId":"","characterSpine":null,"nodeKind":"battle","cutscenes":[{"id":"EP9_5_ACT3_STAGE4_START","title":"Q. 일반인이 고준위 침식파에 노출되면 어떻게 됩니까?","commandCount":138,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE4_START.json","position":"before","label":"전편"},{"id":"EP9_5_ACT3_STAGE4_END","title":"핫……!","commandCount":33,"url":"https://raw.githubusercontent.com/terabraincs/terabraincs.github.io/main/public/story/reader/scenes/EP9_5_ACT3_STAGE4_END.json","position":"after","label":"후편"}],"layout":{"slot":4,"kind":"battle","width":350,"height":110,"visualWidth":468,"visualHeight":228,"x":2045,"y":796,"connectors":[{"name":"LINE_UP","left":1556.68,"top":781,"width":340,"height":50,"angle":30,"originX":1,"originY":0.5}]}},{"id":111141,"strId":"STAGE_MAINSTREAM_111141","act":4,"index":1,"uiNumber":6,"title":"인터루드 #5","description":"CRF는 현실 개변력, 인간의 가능성.\n그들은 놀라운 힘을 가지고 있으나, 그 힘을 의식적으로 사용하는 대신 평생에 걸쳐 허비할 따름이다.","characterId":"NKM_UNIT_MAID_S_LEADER","characterSpine":{"id":"illustration/ab_unit_illust_nkm_unit_maid_s_leader/UNIT_ILLUST_MAID_S_LEADER/UNIT_ILLUST_MAID_S_LEADER","jsonUrl":"https://raw.githubusercontent.com/terabraincs/Asset_spine/main/sp